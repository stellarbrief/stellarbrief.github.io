---
// A small drawing for each tool, so a card or a tab can be told apart at a glance. It repeats nothing the words say, so it
// is hidden from assistive technology.
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<svg class="tool-icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {
    slug === 'upgrade-preflight' && (
      <>
        <rect x="4" y="6" width="14" height="28" rx="3" />
        <rect x="22" y="6" width="14" height="28" rx="3" />
        <path d="M9 14h4M9 20h4M27 14h4M27 20h4M18 31h4" />
      </>
    )
  }
  {
    slug === 'upgrade-drill' && (
      <>
        <circle cx="20" cy="9" r="4" />
        <circle cx="8" cy="30" r="4" />
        <circle cx="32" cy="30" r="4" />
        <path d="M17.5 12.5L10.5 26.5M22.5 12.5l7 14M12 30h16" />
      </>
    )
  }
  {
    slug === 'advisory-brief' && (
      <>
        <path d="M10 5h14l8 8v22H10z" />
        <path d="M24 5v8h8M15 21h12M15 27h8" />
      </>
    )
  }
</svg>
