---
// "What next" at the foot of a page: the previous and the next of the three tools, in the same view, so someone who has read
// one can carry on without finding the menu.
import { projects } from '../data/projects.js';

interface Props {
  current: string;
  view: 'about' | 'playground';
}
const { current, view } = Astro.props;
const index = projects.findIndex((p) => p.slug === current);
const previous = index > 0 ? projects[index - 1] : undefined;
const next = index >= 0 && index < projects.length - 1 ? projects[index + 1] : undefined;
const href = (p: (typeof projects)[number]) => (view === 'playground' ? p.playground : `/projects/${p.slug}/`);
const label = view === 'playground' ? 'playground' : 'tool';
---

<nav class="nextup" aria-label="More tools">
  {
    previous ? (
      <a class="prev" href={href(previous)}>
        <span class="dir">← Previous {label}</span>
        <strong>{previous.name}</strong>
      </a>
    ) : (
      <span></span>
    )
  }
  {
    next && (
      <a class="next" href={href(next)}>
        <span class="dir">Next {label} →</span>
        <strong>{next.name}</strong>
      </a>
    )
  }
</nav>
