---
// The band at the top of every inner page: where you are (breadcrumbs), what this page is, and a sentence about it. What
// goes in the slot sits under the title, for a badge or a line of detail.
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  crumbs?: Crumb[];
}
const { title, crumbs = [] } = Astro.props;
---

<div class="page-header">
  <div class="container">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c, i) => (
              <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1>{title}</h1>
    <slot />
  </div>
</div>
