---
import Base from '../../layouts/Base.astro';
import { KINDS, KIND_MEANING } from '../../lib/provenance.js';
import { projects } from '../../data/projects.js';
---

<Base
  title="Playground"
  description="Real recorded output from the three StellarBrief tools, and the tools' own code running in your browser where that is safe. Every result is labeled with where it came from."
  path="/playground/"
>
  <h1>Playground</h1>
  <p class="lede">
    See what the tools produce without installing anything. Nothing on these pages runs a Stellar
    network. Two of the tools need Docker, which a browser can't provide, so their pages show real recorded
    runs and run the tools' own analysis code on them.
  </p>

  <h2 id="labels">How to read the labels</h2>
  <p>Every result on this site carries one of five labels, with its source and date:</p>
  <dl>
    {
      KINDS.map((k) => (
        <>
          <dt><span class={`badge kind-${k.toLowerCase()}`}>{k}</span></dt>
          <dd style="margin:0 0 0.75rem 0">{KIND_MEANING[k]}</dd>
        </>
      ))
    }
  </dl>
  <p class="small">
    The site build fails if a result has no label, so nothing can appear without saying where it came from.
    No page here currently uses <em>Live</em>.
  </p>

  <h2>Pick a project</h2>
  <div class="grid">
    {
      projects.map((p) => (
        <section class="card">
          <h3>{p.name}</h3>
          <p>{p.tagline}</p>
          <p class="links"><a href={p.playground}>Open the {p.name} playground</a></p>
        </section>
      ))
    }
  </div>
</Base>
