---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ToolNav from '../../components/ToolNav.astro';
import NextUp from '../../components/NextUp.astro';
import { projects, STATUS_CRITERIA, STATUS_REVIEWED, ORG } from '../../data/projects.js';
import { loadGithub, loadManifest, readSynced, readSyncedIfPresent, shortSha } from '../../lib/synced.js';
import { extractSection, renderMarkdown } from '../../lib/markdown.js';
import { withHeadingIds } from '../../lib/headings.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const github = (await loadGithub()).repos[project.repo];
const manifest = (await loadManifest()).repos[project.repo];
const sha = manifest.sha;
const repoUrl = `https://github.com/${ORG}/${project.repo}`;
const blob = (path: string) => `${repoUrl}/blob/${sha}/${path}`;

const readme = await readSynced(project.repo, 'README.md');
const readmeRendered = withHeadingIds(
  await renderMarkdown(readme, { repo: project.repo, sha, file: 'README.md', dropFirstHeading: true }),
  { levels: [2], prefix: 'readme-' },
);

const changelog = await readSyncedIfPresent(project.repo, 'CHANGELOG.md');
const limitsMd = changelog ? extractSection(changelog, 'Known limitations', 3) : null;
const limitsHtml = limitsMd
  ? await renderMarkdown(limitsMd.replace(/^###\s+Known limitations\s*/, ''), { repo: project.repo, sha, file: 'CHANGELOG.md' })
  : null;

const docs = manifest.files.filter((f: string) => f.startsWith('docs/') && f.endsWith('.md'));
const samples = manifest.files.filter((f: string) => f.startsWith('docs/samples/') && f.endsWith('.json') && f.includes('report'));

// What is on this page, for the list that sits beside it (and above it on a phone).
const contents = [
  { id: 'see', text: 'See it work', level: 2 },
  ...(limitsHtml ? [{ id: 'limits', text: 'Current limitations', level: 2 }] : []),
  { id: 'readme', text: 'README', level: 2 },
  ...readmeRendered.headings.map((h) => ({ id: h.id, text: h.text, level: 3 })),
];
---

<Base title={project.name} description={`${project.tagline} ${project.summary}`} path={`/projects/${project.slug}/`}>
  <PageHeader title={project.name} crumbs={[{ label: project.name }]}>
    <p class="status-line">
      <span class="badge status" title={STATUS_CRITERIA[project.status]}>{project.status}</span>
      <span class="small">reviewed {STATUS_REVIEWED}</span>
    </p>
    <p class="lede">{project.tagline}</p>
    <p class="summary">{project.summary}</p>
  </PageHeader>

  <div class="container">
    <ToolNav current={project.slug} view="about" />

    <div class="callout warn">
      <strong>Why {project.status.toLowerCase()}:</strong> {project.statusWhy}
    </div>

    <div class="layout">
      <article class="prose">
        <details class="toc-mobile">
          <summary>On this page</summary>
          <ul>
            {contents.map((c) => <li class={c.level === 3 ? 'sub' : undefined}><a href={`#${c.id}`}>{c.text}</a></li>)}
          </ul>
        </details>

        <h2 id="see">See it work</h2>
        <p>
          <a href={project.playground}>The {project.name} playground</a> shows real recorded output and,
          where the tool's own code can run safely in a browser, runs that code on it. Each result is
          labeled with where it came from.
        </p>

        {limitsHtml && (
          <>
            <h2 id="limits">Current limitations</h2>
            <div set:html={limitsHtml} />
          </>
        )}

        <h2 id="readme">README <span class="small">(from the repository at <code>{shortSha(sha)}</code>)</span></h2>
        <div set:html={readmeRendered.html} />

        <NextUp current={project.slug} view="about" />
      </article>

      <aside class="sidebar" aria-label="On this page and links">
        <nav aria-label="On this page" class="toc">
          <h2>On this page</h2>
          <ul>
            {contents.map((c) => <li class={c.level === 3 ? 'sub' : undefined}><a href={`#${c.id}`}>{c.text}</a></li>)}
          </ul>
        </nav>
        <h2>On GitHub</h2>
        <ul>
          <li><a href={repoUrl}>Repository</a></li>
          <li><a href={`${repoUrl}/issues`}>Issues</a></li>
          <li>
            <a href={`${repoUrl}/releases`}>Releases</a>
            {github?.latestRelease && <span class="small"> (latest {github.latestRelease.tag})</span>}
            {github && !github.latestRelease && !github.error && <span class="small"> (none yet)</span>}
          </li>
          <li><a href={`${repoUrl}/security/advisories/new`}>Report a security issue</a></li>
        </ul>
        <h2>Documentation</h2>
        <ul>
          {docs.map((d: string) => <li><a href={blob(d)}>{d.replace('docs/', '')}</a></li>)}
          {manifest.files.includes('CHANGELOG.md') && <li><a href={blob('CHANGELOG.md')}>CHANGELOG.md</a></li>}
        </ul>
        {samples.length > 0 && (
          <>
            <h2>Recorded samples</h2>
            <ul>
              {samples.map((s: string) => <li><a href={blob(s)}>{s.replace('docs/samples/', '')}</a></li>)}
            </ul>
          </>
        )}
      </aside>
    </div>
  </div>
</Base>
